# DevBoard Environment Variables
# Copy this file to .env and fill in your actual values

# Django Secret Key - Generate a secure one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Debug Mode - Set to False in production
DEBUG=True

# Allowed Hosts - Comma-separated list of domain names
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (for production, use PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/devboard
